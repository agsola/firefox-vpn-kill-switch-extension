{
  "name": "firefox-vpn-kill-switch-extension",
  "version": "0.4.0",
  "private": true,
  "description": "Blocks all traffic that doesn't go through Firefox's built-in VPN.",
  "license": "MIT",
  "author": "Alberto García",
  "repository": "github:agsola/firefox-vpn-kill-switch-extension",
  "scripts": {
    "start": "web-ext run --source-dir extension",
    "start:android": "web-ext run --source-dir extension -t firefox-android",
    "lint": "web-ext lint --source-dir extension",
    "build": "web-ext build --source-dir extension --overwrite-dest",
    "test": "python3 tests/e2e.py",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "web-ext": "^8.0.0",
    "playwright": "^1.58.0"
  }
}
