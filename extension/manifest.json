{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "version": "0.4.0",
  "description": "__MSG_extDescription__",
  "author": "Alberto García",
  "homepage_url": "https://github.com/agsola/firefox-vpn-kill-switch-extension",
  "default_locale": "en",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "proxy",
    "privacy",
    "storage",
    "webRequest",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "__MSG_extName__",
    "default_popup": "pages/popup.html",
    "default_icon": "icons/on.svg"
  },
  "incognito": "spanning",
  "browser_specific_settings": {
    "gecko": {
      "id": "{9641b30d-7263-4f1b-8158-07ecd0697333}",
      "strict_min_version": "149.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "149.0"
    }
  }
}
